<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Private Bounty</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cinzel:wght@400;600;900&family=IM+Fell+English:ital@0;1&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black: #080608;
      --deep: #0e0b10;
      --surface: #15111a;
      --border: #2a2030;
      --gold: #c9a84c;
      --gold-light: #e8cc7a;
      --gold-dim: #7a6228;
      --silver: #a8a8b8;
      --white: #f0ead8;
      --diamond: #a8d8ea;
      --diamond-glow: #6cb8d4;
      --ruby: #c0392b;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--black);
      color: var(--white);
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      line-height: 1.6;
      overflow-x: hidden;
      cursor: default;
    }

    /* Grain overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 9999;
      opacity: 0.35;
    }

    /* ── HERO ── */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      text-align: center;
      padding: 4rem 2rem;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, #1a0e2a 0%, transparent 70%),
        radial-gradient(ellipse 40% 40% at 20% 80%, #1a0808 0%, transparent 60%),
        var(--black);
    }

    .hero::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 200px;
      background: linear-gradient(to bottom, transparent, var(--black));
      pointer-events: none;
    }

    .skull-deco {
      font-size: 3rem;
      letter-spacing: 1.5rem;
      opacity: 0.15;
      margin-bottom: 1.5rem;
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    .hero-eyebrow {
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 0.5rem;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      opacity: 0.8;
    }

    .hero-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(3.5rem, 12vw, 9rem);
      font-weight: 900;
      line-height: 0.9;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold) 40%, var(--gold-dim) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-shadow: none;
      margin-bottom: 0.3em;
      animation: shimmer 4s ease-in-out infinite alternate;
    }

    @keyframes shimmer {
      from { filter: brightness(1); }
      to { filter: brightness(1.15); }
    }

    .hero-sub {
      font-family: 'IM Fell English', serif;
      font-style: italic;
      font-size: clamp(1.1rem, 3vw, 1.6rem);
      color: var(--silver);
      margin-bottom: 2.5rem;
      opacity: 0.75;
    }

    .divider {
      width: 180px;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
      margin: 2rem auto;
    }

    .hero-desc {
      max-width: 540px;
      font-size: 1.1rem;
      color: var(--silver);
      opacity: 0.7;
      margin-bottom: 3rem;
      line-height: 1.8;
    }

    .cta-btn {
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      letter-spacing: 0.3rem;
      text-transform: uppercase;
      color: var(--black);
      background: linear-gradient(135deg, var(--gold-light), var(--gold));
      border: none;
      padding: 1rem 3rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-block;
      clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
    }

    .cta-btn:hover {
      background: linear-gradient(135deg, #fff0b3, var(--gold-light));
      transform: translateY(-2px);
      box-shadow: 0 8px 40px rgba(201, 168, 76, 0.4);
    }

    /* ── CARDS SECTION ── */
    .cards-section {
      padding: 6rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(1.8rem, 5vw, 3rem);
      text-align: center;
      color: var(--gold);
      margin-bottom: 0.5rem;
    }

    .section-sub {
      text-align: center;
      font-style: italic;
      color: var(--silver);
      opacity: 0.6;
      margin-bottom: 4rem;
      font-size: 1.1rem;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 2.5rem 2rem;
      position: relative;
      overflow: hidden;
      transition: transform 0.4s ease, box-shadow 0.4s ease;
      cursor: pointer;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }

    .card:hover {
      transform: translateY(-6px);
    }

    /* Regular */
    .card-regular::before { background: linear-gradient(to right, #888, #ccc, #888); }
    .card-regular:hover { box-shadow: 0 20px 60px rgba(180,180,180,0.15); }
    .card-regular .card-icon { color: #aaa; }
    .card-regular .card-price { color: #ccc; }

    /* Premium */
    .card-premium::before { background: linear-gradient(to right, #6a4fc4, #a07ef0, #6a4fc4); }
    .card-premium:hover { box-shadow: 0 20px 60px rgba(130,90,230,0.2); }
    .card-premium .card-icon { color: #a07ef0; }
    .card-premium .card-price { color: #a07ef0; }

    /* Gold */
    .card-gold::before { background: linear-gradient(to right, var(--gold-dim), var(--gold-light), var(--gold-dim)); }
    .card-gold:hover { box-shadow: 0 20px 60px rgba(201,168,76,0.25); }
    .card-gold .card-icon { color: var(--gold); }
    .card-gold .card-price { color: var(--gold-light); }

    /* Diamond */
    .card-diamond::before { background: linear-gradient(to right, #4a9bb5, var(--diamond), #4a9bb5); }
    .card-diamond:hover { box-shadow: 0 20px 60px rgba(100,184,212,0.3); }
    .card-diamond .card-icon { color: var(--diamond); }
    .card-diamond .card-price { color: var(--diamond); }

    .card-badge {
      position: absolute;
      top: 1.2rem; right: 1.2rem;
      font-family: 'Cinzel', serif;
      font-size: 0.55rem;
      letter-spacing: 0.15rem;
      padding: 0.3rem 0.7rem;
      border: 1px solid currentColor;
      text-transform: uppercase;
    }

    .card-diamond .card-badge { color: var(--diamond); }
    .card-gold .card-badge { color: var(--gold); }
    .card-premium .card-badge { color: #a07ef0; }
    .card-regular .card-badge { color: #aaa; display: none; }

    .card-icon { font-size: 2.5rem; margin-bottom: 1rem; display: block; }

    .card-name {
      font-family: 'Cinzel', serif;
      font-size: 1.2rem;
      letter-spacing: 0.1rem;
      margin-bottom: 0.5rem;
      color: var(--white);
    }

    .card-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.8rem;
      font-weight: 300;
      line-height: 1;
      margin-bottom: 1.5rem;
    }

    .card-price span {
      font-size: 1rem;
      opacity: 0.6;
      vertical-align: super;
    }

    .card-features {
      list-style: none;
      margin-bottom: 2rem;
      font-size: 0.95rem;
      color: var(--silver);
      opacity: 0.75;
    }

    .card-features li {
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--border);
      font-style: italic;
    }

    .card-features li::before { content: '✦ '; opacity: 0.5; }

    .buy-btn {
      width: 100%;
      font-family: 'Cinzel', serif;
      font-size: 0.7rem;
      letter-spacing: 0.25rem;
      text-transform: uppercase;
      background: transparent;
      border: 1px solid currentColor;
      padding: 0.85rem;
      cursor: pointer;
      transition: all 0.3s ease;
      color: inherit;
    }

    .card-regular .buy-btn { color: #ccc; }
    .card-regular .buy-btn:hover { background: rgba(200,200,200,0.1); }
    .card-premium .buy-btn { color: #a07ef0; }
    .card-premium .buy-btn:hover { background: rgba(130,90,230,0.15); }
    .card-gold .buy-btn { color: var(--gold); }
    .card-gold .buy-btn:hover { background: rgba(201,168,76,0.1); box-shadow: 0 0 20px rgba(201,168,76,0.2); }
    .card-diamond .buy-btn { color: var(--diamond); }
    .card-diamond .buy-btn:hover { background: rgba(100,184,212,0.1); box-shadow: 0 0 20px rgba(100,184,212,0.2); }

    /* ── PAYMENT MODAL ── */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      backdrop-filter: blur(6px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .modal-overlay.active { display: flex; }

    .modal {
      background: var(--deep);
      border: 1px solid var(--border);
      max-width: 520px;
      width: 100%;
      position: relative;
      animation: modalIn 0.3s ease;
      max-height: 90vh;
      overflow-y: auto;
    }

    @keyframes modalIn {
      from { opacity: 0; transform: translateY(20px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .modal-header {
      padding: 2rem 2rem 1rem;
      border-bottom: 1px solid var(--border);
      position: relative;
    }

    .modal-title {
      font-family: 'Cinzel', serif;
      font-size: 1.3rem;
      color: var(--gold);
    }

    .modal-subtitle {
      font-style: italic;
      color: var(--silver);
      opacity: 0.6;
      font-size: 0.95rem;
      margin-top: 0.3rem;
    }

    .modal-close {
      position: absolute;
      top: 1.5rem; right: 1.5rem;
      background: none; border: none;
      color: var(--silver);
      font-size: 1.5rem;
      cursor: pointer;
      line-height: 1;
      opacity: 0.6;
      transition: opacity 0.2s;
    }

    .modal-close:hover { opacity: 1; }

    .modal-body { padding: 2rem; }

    .payment-tabs {
      display: flex;
      gap: 0;
      margin-bottom: 2rem;
      border: 1px solid var(--border);
    }

    .payment-tab {
      flex: 1;
      padding: 0.85rem;
      background: transparent;
      border: none;
      color: var(--silver);
      font-family: 'Cinzel', serif;
      font-size: 0.7rem;
      letter-spacing: 0.15rem;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s;
      opacity: 0.5;
    }

    .payment-tab.active {
      background: var(--surface);
      color: var(--gold);
      opacity: 1;
      border-bottom: 2px solid var(--gold);
    }

    .payment-tab:hover:not(.active) { opacity: 0.8; background: rgba(255,255,255,0.03); }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    /* Crypto tab */
    .crypto-options {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
      margin-bottom: 1.5rem;
    }

    .crypto-option {
      border: 1px solid var(--border);
      padding: 1rem;
      background: transparent;
      color: var(--white);
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 0.7rem;
      font-family: 'Cormorant Garamond', serif;
      font-size: 1rem;
      text-align: left;
    }

    .crypto-option:hover, .crypto-option.selected {
      border-color: var(--gold);
      background: rgba(201,168,76,0.08);
      color: var(--gold);
    }

    .crypto-icon { font-size: 1.4rem; }

    .no-kyc-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(0,180,100,0.1);
      border: 1px solid rgba(0,180,100,0.3);
      color: #5de8a0;
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
      font-family: 'Cinzel', serif;
      letter-spacing: 0.1rem;
      margin-bottom: 1.5rem;
    }

    .pay-amount {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 1rem 1.5rem;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .pay-amount-label { font-size: 0.85rem; color: var(--silver); opacity: 0.6; font-style: italic; }
    .pay-amount-value { font-family: 'Cinzel', serif; color: var(--gold); font-size: 1.4rem; }

    .pay-now-btn {
      width: 100%;
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      letter-spacing: 0.3rem;
      text-transform: uppercase;
      color: var(--black);
      background: linear-gradient(135deg, var(--gold-light), var(--gold));
      border: none;
      padding: 1.1rem;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .pay-now-btn:hover {
      background: linear-gradient(135deg, #fff0b3, var(--gold-light));
      box-shadow: 0 6px 30px rgba(201,168,76,0.35);
    }

    .pay-now-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* Fiat tab */
    .fiat-form { display: flex; flex-direction: column; gap: 1rem; }

    .form-group { display: flex; flex-direction: column; gap: 0.4rem; }

    .form-label {
      font-family: 'Cinzel', serif;
      font-size: 0.65rem;
      letter-spacing: 0.2rem;
      text-transform: uppercase;
      color: var(--silver);
      opacity: 0.6;
    }

    .form-input {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--white);
      padding: 0.85rem 1rem;
      font-family: 'Cormorant Garamond', serif;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-input:focus { border-color: var(--gold); }
    .form-input::placeholder { color: var(--silver); opacity: 0.3; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    .stripe-note {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--silver);
      opacity: 0.5;
      font-style: italic;
      margin-top: 0.5rem;
    }

    /* ── TRUST SECTION ── */
    .trust-section {
      border-top: 1px solid var(--border);
      padding: 5rem 2rem;
      text-align: center;
      background: radial-gradient(ellipse 60% 40% at 50% 50%, #12091e 0%, transparent 70%);
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 2rem;
      max-width: 800px;
      margin: 3rem auto 0;
    }

    .trust-item { padding: 1.5rem; }
    .trust-icon { font-size: 2rem; margin-bottom: 0.8rem; display: block; }
    .trust-label {
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 0.15rem;
      color: var(--gold);
      display: block;
      margin-bottom: 0.4rem;
    }
    .trust-desc { font-size: 0.9rem; color: var(--silver); opacity: 0.55; font-style: italic; }

    /* ── FOOTER ── */
    footer {
      border-top: 1px solid var(--border);
      padding: 2rem;
      text-align: center;
      font-size: 0.85rem;
      color: var(--silver);
      opacity: 0.4;
      font-style: italic;
    }

    /* ── LOADING STATE ── */
    .loading-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.9);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 1.5rem;
    }

    .loading-overlay.active { display: flex; }

    .spinner {
      width: 48px; height: 48px;
      border: 2px solid var(--border);
      border-top-color: var(--gold);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .loading-text {
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 0.3rem;
      color: var(--gold);
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--black); }
    ::-webkit-scrollbar-thumb { background: var(--gold-dim); }

    @media (max-width: 600px) {
      .cards-grid { grid-template-columns: 1fr; }
      .crypto-options { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <!-- HERO -->
  <section class="hero">
    <div class="skull-deco">✦ ☽ ✦</div>
    <p class="hero-eyebrow">Exclusive Membership</p>
    <h1 class="hero-title">Private<br>Bounty</h1>
    <p class="hero-sub">Where Privilege Has a Price — and a Promise</p>
    <div class="divider"></div>
    <p class="hero-desc">
      Step into an elite circle of collectors and connoisseurs. Each fan card unlocks a world 
      of exclusive access, curated privileges, and untold rewards. Anonymous. Borderless. Yours.
    </p>
    <a href="#cards" class="cta-btn">Claim Your Card</a>
  </section>

  <!-- CARDS -->
  <section class="cards-section" id="cards">
    <h2 class="section-title">Choose Your Tier</h2>
    <p class="section-sub">Four levels of privilege. One world of access.</p>

    <div class="cards-grid">

      <!-- Regular -->
      <div class="card card-regular" onclick="openModal('Regular Fan Card', 200)">
        <span class="card-icon">🃏</span>
        <h3 class="card-name">Regular</h3>
        <div class="card-price"><span>$</span>200</div>
        <ul class="card-features">
          <li>Member access pass</li>
          <li>Monthly exclusive drops</li>
          <li>Private community entry</li>
          <li>Digital collectible card</li>
        </ul>
        <button class="buy-btn">Acquire Card</button>
      </div>

      <!-- Premium -->
      <div class="card card-premium" onclick="openModal('Premium Fan Card', 450)">
        <span class="card-badge">Popular</span>
        <span class="card-icon">💜</span>
        <h3 class="card-name">Premium</h3>
        <div class="card-price"><span>$</span>450</div>
        <ul class="card-features">
          <li>All Regular perks</li>
          <li>Priority early access</li>
          <li>Exclusive content vault</li>
          <li>VIP messaging channel</li>
        </ul>
        <button class="buy-btn">Acquire Card</button>
      </div>

      <!-- Gold -->
      <div class="card card-gold" onclick="openModal('Gold Fan Card', 750)">
        <span class="card-badge">Elite</span>
        <span class="card-icon">✨</span>
        <h3 class="card-name">Gold</h3>
        <div class="card-price"><span>$</span>750</div>
        <ul class="card-features">
          <li>All Premium perks</li>
          <li>Quarterly rare collectibles</li>
          <li>1-on-1 exclusive sessions</li>
          <li>Gold verified status</li>
        </ul>
        <button class="buy-btn">Acquire Card</button>
      </div>

      <!-- Diamond -->
      <div class="card card-diamond" onclick="openModal('Diamond Fan Card', 1000)">
        <span class="card-badge">Pinnacle</span>
        <span class="card-icon">💎</span>
        <h3 class="card-name">Diamond</h3>
        <div class="card-price"><span>$</span>1,000</div>
        <ul class="card-features">
          <li>All Gold perks</li>
          <li>Lifetime diamond status</li>
          <li>Inner circle access</li>
          <li>Bespoke concierge service</li>
        </ul>
        <button class="buy-btn">Acquire Card</button>
      </div>

    </div>
  </section>

  <!-- TRUST -->
  <section class="trust-section">
    <h2 class="section-title">Why Private Bounty</h2>
    <p class="section-sub">Built for a world without borders or barriers.</p>
    <div class="trust-grid">
      <div class="trust-item">
        <span class="trust-icon">🌍</span>
        <span class="trust-label">Global Access</span>
        <p class="trust-desc">Available in every country, no restrictions.</p>
      </div>
      <div class="trust-item">
        <span class="trust-icon">🔒</span>
        <span class="trust-label">No KYC</span>
        <p class="trust-desc">Anonymous crypto payments. Your privacy is sacred.</p>
      </div>
      <div class="trust-item">
        <span class="trust-icon">⚡</span>
        <span class="trust-label">Instant Access</span>
        <p class="trust-desc">Payment confirmed, membership activated immediately.</p>
      </div>
      <div class="trust-item">
        <span class="trust-icon">₿</span>
        <span class="trust-label">Crypto & Fiat</span>
        <p class="trust-desc">Pay with crypto or card — your choice.</p>
      </div>
    </div>
  </section>

  <footer>
    <p>© 2026 Private Bounty · All rights reserved · Exclusive Memberships Worldwide</p>
  </footer>

  <!-- PAYMENT MODAL -->
  <div class="modal-overlay" id="modalOverlay" onclick="closeModalOutside(event)">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title" id="modalTitle">Diamond Fan Card</div>
        <div class="modal-subtitle">Complete your membership below</div>
        <button class="modal-close" onclick="closeModal()">×</button>
      </div>
      <div class="modal-body">

        <div class="pay-amount">
          <span class="pay-amount-label">Total Due</span>
          <span class="pay-amount-value" id="modalPrice">$1,000</span>
        </div>

        <div class="payment-tabs">
          <button class="payment-tab active" onclick="switchTab('crypto')">🔐 Crypto</button>
          <button class="payment-tab" onclick="switchTab('fiat')">💳 Card</button>
        </div>

        <!-- CRYPTO TAB -->
        <div class="tab-content active" id="tab-crypto">
          <div class="no-kyc-badge">✓ &nbsp;No KYC Required · Anonymous Payment</div>

          <p style="font-style:italic; color:var(--silver); opacity:0.6; font-size:0.9rem; margin-bottom:1.2rem;">
            Select your preferred cryptocurrency:
          </p>

          <div class="crypto-options">
            <button class="crypto-option selected" onclick="selectCrypto(this, 'BTC')">
              <span class="crypto-icon">₿</span> Bitcoin
            </button>
            <button class="crypto-option" onclick="selectCrypto(this, 'ETH')">
              <span class="crypto-icon">Ξ</span> Ethereum
            </button>
            <button class="crypto-option" onclick="selectCrypto(this, 'LTC')">
              <span class="crypto-icon">Ł</span> Litecoin
            </button>
            <button class="crypto-option" onclick="selectCrypto(this, 'USDT')">
              <span class="crypto-icon">₮</span> USDT
            </button>
            <button class="crypto-option" onclick="selectCrypto(this, 'BNB')">
              <span class="crypto-icon">◈</span> BNB
            </button>
            <button class="crypto-option" onclick="selectCrypto(this, 'DOGE')">
              <span class="crypto-icon">Ð</span> Dogecoin
            </button>
          </div>

          <button class="pay-now-btn" onclick="payCrypto()">
            Pay with Crypto via Plisio
          </button>

          <p style="font-size:0.78rem; color:var(--silver); opacity:0.4; text-align:center; margin-top:1rem; font-style:italic;">
            Powered by Plisio · Secure · No account needed
          </p>
        </div>

        <!-- FIAT TAB -->
        <div class="tab-content" id="tab-fiat">
          <div class="fiat-form">
            <div class="form-group">
              <label class="form-label">Cardholder Name</label>
              <input class="form-input" type="text" placeholder="Full name on card" id="cardName"/>
            </div>
            <div class="form-group">
              <label class="form-label">Email Address</label>
              <input class="form-input" type="email" placeholder="your@email.com" id="cardEmail"/>
            </div>
            <div class="form-group">
              <label class="form-label">Card Number</label>
              <input class="form-input" type="text" placeholder="1234 5678 9012 3456" maxlength="19" id="cardNumber" oninput="formatCard(this)"/>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Expiry</label>
                <input class="form-input" type="text" placeholder="MM / YY" maxlength="7" id="cardExpiry" oninput="formatExpiry(this)"/>
              </div>
              <div class="form-group">
                <label class="form-label">CVV</label>
                <input class="form-input" type="text" placeholder="•••" maxlength="4" id="cardCVV"/>
              </div>
            </div>
            <button class="pay-now-btn" onclick="payFiat()">
              Complete Payment
            </button>
            <p class="stripe-note">🔒 Secured by Stripe · 256-bit SSL encryption</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- LOADING -->
  <div class="loading-overlay" id="loadingOverlay">
    <div class="spinner"></div>
    <div class="loading-text">Processing Payment...</div>
  </div>

  <script>
    // ── CONFIG ──
    // ⚠️ REPLACE THESE WITH YOUR ACTUAL KEYS BEFORE GOING LIVE
    const CONFIG = {
      plisioApiKey: 'YOUR_PLISIO_SECRET_API_KEY',   // Get from plisio.net dashboard
      btcWallet:    'YOUR_BITCOIN_TRUST_WALLET_ADDRESS', // Your Trust Wallet BTC address
      stripeKey:    'YOUR_STRIPE_PUBLISHABLE_KEY',   // Get from stripe.com dashboard
      shopName:     'Private Bounty',
      shopEmail:    'your@email.com',                // Your contact email
    };

    let currentCard = '';
    let currentAmount = 0;
    let selectedCrypto = 'BTC';

    function openModal(cardName, amount) {
      currentCard = cardName;
      currentAmount = amount;
      document.getElementById('modalTitle').textContent = cardName;
      document.getElementById('modalPrice').textContent = '$' + amount.toLocaleString();
      document.getElementById('modalOverlay').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('modalOverlay').classList.remove('active');
      document.body.style.overflow = '';
    }

    function closeModalOutside(e) {
      if (e.target === document.getElementById('modalOverlay')) closeModal();
    }

    function switchTab(tab) {
      document.querySelectorAll('.payment-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      event.target.classList.add('active');
      document.getElementById('tab-' + tab).classList.add('active');
    }

    function selectCrypto(el, coin) {
      document.querySelectorAll('.crypto-option').forEach(o => o.classList.remove('selected'));
      el.classList.add('selected');
      selectedCrypto = coin;
    }

    // ── CRYPTO PAYMENT via Plisio ──
    async function payCrypto() {
      showLoading();

      // Build Plisio payment URL
      // Docs: https://plisio.net/documentation/endpoints/create-invoice
      const params = new URLSearchParams({
        api_key:      CONFIG.plisioApiKey,
        currency:     selectedCrypto,
        amount:       currentAmount,
        order_name:   currentCard,
        order_number: 'PB-' + Date.now(),
        email:        CONFIG.shopEmail,
        description:  CONFIG.shopName + ' — ' + currentCard,
        // Plisio will forward funds to your wallet configured in their dashboard
        // Set CONFIG.btcWallet as your payout address in Plisio settings
        success_url:  window.location.origin + '?status=success',
        cancel_url:   window.location.origin + '?status=cancel',
      });

      try {
        // In production, this call should go through YOUR backend to protect the API key
        // For now this is a direct redirect to the Plisio hosted invoice page
        const plisioUrl = `https://plisio.net/api/v1/invoices/new?${params.toString()}`;
        const res = await fetch(plisioUrl);
        const data = await res.json();

        hideLoading();

        if (data.status === 'success' && data.data?.invoice_url) {
          window.location.href = data.data.invoice_url;
        } else {
          // Fallback: open Plisio dashboard payment page
          alert('Redirecting to Plisio payment page...\n\nNote: Set your API key in CONFIG to enable live payments.');
          // window.open('https://plisio.net', '_blank');
          hideLoading();
        }
      } catch (err) {
        hideLoading();
        alert('Payment gateway error. Please check your Plisio API key configuration.\n\nError: ' + err.message);
      }
    }

    // ── FIAT PAYMENT via Stripe ──
    async function payFiat() {
      const name  = document.getElementById('cardName').value.trim();
      const email = document.getElementById('cardEmail').value.trim();
      const num   = document.getElementById('cardNumber').value.trim();
      const exp   = document.getElementById('cardExpiry').value.trim();
      const cvv   = document.getElementById('cardCVV').value.trim();

      if (!name || !email || !num || !exp || !cvv) {
        alert('Please fill in all card details.');
        return;
      }

      showLoading();

      // ── STRIPE INTEGRATION NOTE ──
      // For real card processing you need:
      // 1. Include Stripe.js: <script src="https://js.stripe.com/v3/"></script>
      // 2. Create a PaymentIntent on YOUR SERVER (never expose secret key client-side)
      // 3. Use stripe.confirmCardPayment() with the client_secret
      //
      // Example backend call (Node.js / Python / PHP):
      //   POST /create-payment-intent  { amount: currentAmount*100, currency: 'usd' }
      //   Returns: { clientSecret: 'pi_xxx_secret_xxx' }
      //
      // Then client-side:
      //   const stripe = Stripe(CONFIG.stripeKey);
      //   const result = await stripe.confirmCardPayment(clientSecret, {
      //     payment_method: { card: cardElement, billing_details: { name, email } }
      //   });

      setTimeout(() => {
        hideLoading();
        alert('⚠️ Card payment requires a backend server with Stripe configured.\n\nTo activate:\n1. Add your Stripe keys in CONFIG\n2. Set up a server endpoint at /create-payment-intent\n3. Integrate Stripe.js\n\nSee code comments for full instructions.');
      }, 1500);
    }

    function showLoading() { document.getElementById('loadingOverlay').classList.add('active'); }
    function hideLoading() { document.getElementById('loadingOverlay').classList.remove('active'); }

    // Card formatting helpers
    function formatCard(el) {
      let v = el.value.replace(/\D/g, '').substring(0, 16);
      el.value = v.replace(/(.{4})/g, '$1 ').trim();
    }

    function formatExpiry(el) {
      let v = el.value.replace(/\D/g, '').substring(0, 4);
      if (v.length >= 2) v = v.substring(0,2) + ' / ' + v.substring(2);
      el.value = v;
    }

    // Check URL params for payment status
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('status') === 'success') {
      setTimeout(() => alert('✅ Payment successful! Welcome to Private Bounty. Check your email for access details.'), 500);
    }
  </script>
</body>
</html>
