PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/johnny-depp-fan-cards
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Plisio Payment Gateway (Crypto + Fiat)
PLISIO_API_KEY=your_plisio_api_key_here
PLISIO_SECRET_KEY=your_plisio_secret_key_here
PLISIO_WEBHOOK_SECRET=your_plisio_webhook_secret_here

# Bitcoin Address (Trust Wallet)
BITCOIN_WALLET_ADDRESS=your_bitcoin_address_here

# Supported Cryptocurrencies
PLISIO_SUPPORTED_COINS=BTC,ETH,USDT,USDC,LTC,DASH,XRP,ADA

# Coinbase Commerce (Optional - Additional Crypto Option)
COINBASE_API_KEY=your_coinbase_api_key_optional
COINBASE_WEBHOOK_SECRET=your_coinbase_webhook_secret_optional

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (Optional - for order notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Application Settings
APP_NAME=Johnny Depp Fan Cards
LOG_LEVEL=info
